{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noai, noimageai"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/((?!ai-blocked\\.html|robots\\.txt).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(GPTBot|ChatGPT-User|OAI-SearchBot|ClaudeBot|Claude-Web|Claude-User|Claude-SearchBot|anthropic-ai|CCBot|PerplexityBot|Perplexity-User|Bytespider|Amazonbot|meta-externalagent|Meta-ExternalFetcher|FacebookBot|Diffbot|cohere-ai|cohere-training-data-crawler|YouBot|Timpibot|ImagesiftBot|omgili|omgilibot|AI2Bot|Ai2Bot-Dolma|DuckAssistBot|MistralAI-User|PanguBot|Kangaroo Bot|Webzio-Extended|img2dataset|VelenPublicWebCrawler|Scrapy|ICC-Crawler|Novellum|QualifiedBot|SemrushBot-OCOB|TikTokSpider|Brightbot|iaskspider|PhindBot|Andibot|Factset_spyderbot|FirecrawlAgent|Crawlspace|Bigsur\\.ai|EchoboxBot|Devin|LinerBot).*"
        }
      ],
      "destination": "/ai-blocked.html",
      "permanent": false
    }
  ]
}
